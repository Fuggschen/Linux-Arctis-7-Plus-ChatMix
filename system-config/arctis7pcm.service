[Unit]
Description=Arctis 7+ ChatMix
Documentation=https://github.com/birdybirdonline/Linux-Arctis-7-Plus-ChatMix
# PipeWire must be up before we create the virtual sinks, and if it is ever
# restarted the sinks we created are destroyed with it -- so restart with it.
After=pipewire.service
Wants=pipewire.service
PartOf=pipewire.service
Wants=dev-arctis7.device
# Never give up permanently. The daemon exits 1 whenever the dongle is absent
# (including at boot before the user session starts), so rate limiting here
# would leave ChatMix dead with no way back other than a manual restart.
StartLimitIntervalSec=0

[Service]
Type=simple
Environment="XDG_RUNTIME_DIR=/run/user/%U"
Environment="PIPEWIRE_RUNTIME_DIR=/run/user/%U"
ExecStart=/usr/bin/python3 %h/.local/bin/Arctis_7_Plus_ChatMix.py
# "always" rather than "on-failure": also covers any future clean-exit path
# that indicates the dongle went away. An explicit `systemctl stop` still
# stops the unit, and linger keeps it resident.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
